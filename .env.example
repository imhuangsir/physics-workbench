# 老师后台登录密码（单一管理员）
ADMIN_PASSWORD=
# JWT 签名密钥，至少 32 字符
AUTH_SECRET=

# ②③ 轮 · AI 网关（Anthropic Messages 兼容；本地填 .dev.vars，线上用 wrangler secret put）
# 默认沿用 Claude Code 当前网关：base=https://ps.air-outer.com, model=deepseek-v4-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_STYLE=

# ⑤ 轮 · OCR 切题（腾讯云 GeneralBasicOCR；未配置则导入功能提示未开通）
OCR_PROVIDER=
OCR_SECRET_ID=
OCR_SECRET_KEY=
OCR_REGION=
